  {
   "seq": "14",
   "text": "花もまたわかれん春は思ひ出よされちみたひの心つくしを",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "う〳〵ひすもよはうき物と智けり出しふるすへ立帰るらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "うくひすもよはうき物と知りけり出しふるすへ立帰るらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "あそひの神花かきを白なみはさらす布とは思ひかくらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "なつ",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "一なつかりのせこふみしたきほる野にしほりやすらんさゆかはの花",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "ふなてせぬとこもかきねに成にけり高瀬の淀の五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "いたつらに老にけりしなあはれ我か友とはみすや松の下くり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "夏ふかみはらみにけりなしの薄したはひまとふ葛の帯して",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "ゆふすゝみあたねの庵の明方にすたれうこかし秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "秋来ぬと思ふよりこそわひしけれね覚に虫の鳴んとすらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "あきといへはなけきも鳥やかはらめけ更にまたしむ心ちする",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "露むすふ山田もるこか袖ぬれて物や思ふととはまほしくも",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "きり〳〵す雲井の鳫に何といひてかへのそこより声あはす覧",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "古郷の一村萩の花さかりたれきてみよと色こかるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "ねさめして残れるよはの月みれは行ともなくてかたふきにけり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "月清みむこの高ねに雪ふりてつもりの浦によする白たま",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "〽いまはとて見てらん秋の空まても思へはかなし秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "むしの松も心こにいそくなりはたをるあれはつゝりさせてふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "なかき夜の友とそたのむきり〳〵す我もつねには蓬生のねや",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一秋風にからみ渡りし葛のはの猶あかすとや色ことになる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "秋の夜の物悲しさをいかにしてうき世の外にゐて心みん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "とにかくに見るわれくるし秋萩の花はうつろひ下草色つく",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "花かはる三山おろしの浜風にふな木もはやく紅葉しにけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "このはちる残りすくなき風の音にしつのきぬた事衣うちそふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "たくひなく心ほそしや行秋のすこし残れる有あけのつき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "きり〳〵すあなかましはしと思しにかれ行声を聞もわかなし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "かきくもりしくれもあへす出る日のかけよはり行冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "葉の戸をたゝし嵐の音さむみあくる物うき冬のつとめて",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "むしの夜のよりりはてぬる庭の西に華の枯はの音そ残れる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "神無月いかなる時の雨なれはかきくもりより物かなしかる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "みちふかみいとひし庭のよもさふの霜かれ行も物そとしき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "つのくみしあしへほとなく枯にけりなにはの事もかゝるよそかし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "きゝすなく哀はたれも有物をかりはれをのにたぬはかりそ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "秋はつる山田のそほつ心ありや同しうきよの物かたりせん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "そ朝みれは隣ひとつになりにけりへうつる此のよ半の雷折",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "白雪のふりつむ野人の萩かえに春待守はいかゝりひしき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "原の池につらゝゐにけり打むれて渡るあきけの今朝は出りゐる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "山川のさゝれかうへのうす氷ゆきみ行すみむすほれにけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "行年のけしきはいつもかはらぬに物忠しさそいやまさりぬる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "かひ草のしけみにをける露の命なひてもまたて消ぬへき哉",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "慈",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "物思ひを何のやまひとそふ人のなれぬけしきもうしやまれける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "かひなくていけるそつらきわひぬれはあはぬ知せん名をもおしませ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "身のほともしらぬ心のつきしより思しことそなけきせんとは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "人心あなあやにくの世中ににくみいとへはこひしりりなし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "こひしてふ事をたれかははしめけんつゝき物から哀とそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "見せはや友をしまのあまの袖たにもぬれにそぬれし色は智らす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いつ方へ人の心のはなちとりわかひとりねにかへらさるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "わすれすななをさりことをたのめをきて空をしみせし暁の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "まちかねて伏見の山田鳳吹はそよかへらんと契りやハせし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "忘れにしいもかことをは過きぬと誰に語てこよひねぬらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "あかざりし匂ひ残れるさむしろは独ぬるにもおきうかりけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "「すれなはいけらん物と思ひしにそれもかなはぬ此世なりけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "へうつとていとひしよはのさ衣を返してねたる夢にたにこぬ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "うらみすよなけのなさけのこれをたになからへはてゝきかん物かは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "りすれしとつねにはいひしことくをのやそのきはにかれも行哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "あかぬ夜は返すといひし衣手を引とめてたに恨かけはや",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "心にもあかすといひてよかれせしおり〳〵はかりあふよしもかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "しはしこそこぬ夜のなりとはらひしか枕のうへに苦むしにけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "はかなしなたゝ君ひとり世中にある物とのみ思ふはやわれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "千はやふるちひろたくなはもゝ結ひうちとけてぬき長き心を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "我恋に上位のからふり給らはなみたにそむるあけの絹きん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "蕪草にまかひてたてるわか松の行末遠き君か御代かな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "月を見て思はぬ事はなけれとも猶出しきはやみに迷はん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "つく〳〵と思へは悲しあか月のね覚も夢を見るにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "から出しかきはむかしに成はてゝあらぬ世に成かつまたの記",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "いたつらに老ぬる松をともなへと千世には元こそたらはさりけれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "露の身の何にかゝりて返すらんさすかにもとのしつくともなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "いにしへは老もやすると頼みありきさて此比はいかにたゆむそ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "春の花咲てはよりき秋の月みちてはかけぬあなう世の中",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "うき世そと人はいへともえそしらぬともあらぬ折のならひなけれは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "あり〳〵て今はの時やわれか身の世の人かすにならんとすらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "をきてちる物思ひなき埋木もくち行はての悲しからすや",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "花も葉も落ちかときの有物を思ひもあへぬ人の世のうき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "きえぬへき露のうき身のをき所つゝれの野人の草葉成らん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "こりはてぬ色にはしまし山吹の匂ふ清水をくみて思ふに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "あさからす思ふかためのいつはりにこほりもふかくみ大にける哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "くれかたくあかしくらしつ春秋のいかにつもりてさま替る覧",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "上陽人",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "かりころもしかまのかちにそめてきんのことの露にかはらさるへき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隠題きんのこと",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "よそにてもわれをおもりぬひとりふせ恋しといふもさゝは頼まん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ひとりふせこ",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "たかの山みねの朝日をまへとてそかみなきみちにおもひ入ける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高野大師",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "心よりいつるおもひのわかすゆにかへる〳〵もにゆるかなしき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "地こく",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "笛の音も琴のしらへも紫の雲にしみ行あかつきのそら",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "極楽",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "このしな匂ふ台に生れては一ののりのうひことをせん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "よとともにえのめつらしき色々の花はかれせす鳥は帰らす",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "秋の夜の月のみかほはのとけくて春の半にかくれすも哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "芋厳経",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "大いまはとて衣をかけし此のはのそよいかはかりとしかりけん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "最勝王経",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "むろの内もさとる心しひろけれはよろつの床をみてそ立ける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御幸経",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "今そしる露のはやしは名のみしてわしの高ねに語る月影",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "法花経",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "つく〳〵と思ひとくこそ恐しけれ雪のみ山の鳥の鳥のをしへに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "涅槃経",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "神山の霞吹とくはる風に色こくなりぬあけの玉かき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "賀茂の神主重得よみたらん爰ともかきあつめてみやしろにおさめんと申せは書てをくるとておくに"
  },
  {
   "seq": "104",
   "text": "しめの田に色こくみゆる桜花天下りけん昔をも不ゆ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "105",
   "text": "帰る屏みたらし川にうつろへは水のしらへのことぢなりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "106",
   "text": "年を歴て花の都に住かひはう月のいみにもれぬなりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "107",
   "text": "夕してや秋の初風明ぬゝしそよ〳〵いたく身にもしむ哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "108",
   "text": "月やとるかもの川霧晴ゆけは雲間をいつる心ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "109",
   "text": "神垣のくすの紅葉の色こきはみる〳〵露のそむるなりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "110",
   "text": "をく霜やそめかへつらんあさち原うらかれ色の紫しのへ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "111",
   "text": "神さひて年はふれともひめ小松若えさしそふ後そ替らぬ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "112",
   "text": "もろ人をわたすちかひのたえせぬはみたらし川のとつ宮敷",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "113",
   "text": "かきりありし鶴のはやしのかたみをはとゝめおきつるいかるかの里",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "法修寺舎利の御ばこの哥をみて"
  },
  {
   "seq": "114",
   "text": "聞たにも雲井の外のかひもなしそむきにし世の猶そ忠しき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "115",
   "text": "恐しきのみるめのまへを思やれそむきにし世のよその哀に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "116",
   "text": "いか斗かなしとかしも世のうさに捨るこの身の身のおや岩心は",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "117",
   "text": "花の色もうれ世にかふる墨染の袖や浮世に猶しつくらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "118",
   "text": "一巻そめを花の衣にたちかへし泪の色はあはれともみき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "119",
   "text": "君かいるまことの道の月の影夢と見し世も今やてらさむ",
   "kana": "",
   "speaker": "寂空",
   "page": 8,
   "pid": "nao-733338",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  }
 ],
